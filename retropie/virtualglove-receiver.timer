# Project: VirtualGlove
# File: retropie/virtualglove-receiver.timer
# Purpose: Delay receiver startup until the RetroPie boot and EmulationStation device scan settle.
# Author: Iain Bennett
# Copyright (c) 2026 Iain Bennett
# SPDX-License-Identifier: MIT
# Change log:
#   2026-09-03 - Added with standardized source documentation.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=Start VirtualGlove receiver after EmulationStation settles

[Timer]
OnBootSec=45s
AccuracySec=1s
Unit=virtualglove-receiver.service

[Install]
WantedBy=timers.target
