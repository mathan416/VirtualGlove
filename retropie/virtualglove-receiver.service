# Change log:
#   2026-09-02 - Added to VirtualGlove.
#   2026-09-03 - Standardized source documentation and maintenance metadata.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=VirtualGlove virtual gamepad receiver
Wants=network-online.target
After=network-online.target
ConditionFileNotEmpty=/etc/virtualglove/token

[Service]
Type=simple
User=root
RuntimeDirectory=virtualglove
RuntimeDirectoryMode=0755
ExecStart=/opt/virtualglove/bin/virtualglove-receiver --listen 0.0.0.0 --token-file /etc/virtualglove/token
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
