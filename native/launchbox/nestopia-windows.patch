 static uint64_t pgv_monotonic_ns(void)
 {
+#ifdef _WIN32
+   LARGE_INTEGER value, frequency;
+   if (!QueryPerformanceCounter(&value) || !QueryPerformanceFrequency(&frequency) ||
+       frequency.QuadPart <= 0)
+      return 0;
+   return (uint64_t)(value.QuadPart / frequency.QuadPart) * 1000000000ULL +
+      (uint64_t)(value.QuadPart % frequency.QuadPart) * 1000000000ULL /
+      (uint64_t)frequency.QuadPart;
+#else
    struct timespec value;
    return clock_gettime(CLOCK_MONOTONIC, &value) == 0
       ? (uint64_t)value.tv_sec * 1000000000ULL + value.tv_nsec : 0;
+#endif
 }
 
 static void pgv_native_close(void)
 {
+#ifdef _WIN32
    if (pgv_native)
+      UnmapViewOfFile((const void*)pgv_native);
+   if (pgv_native_mapping)
+      CloseHandle(pgv_native_mapping);
+   if (pgv_native_file != INVALID_HANDLE_VALUE)
+      CloseHandle(pgv_native_file);
+   pgv_native = NULL;
+   pgv_native_mapping = NULL;
+   pgv_native_file = INVALID_HANDLE_VALUE;
+#else
+   if (pgv_native)
       munmap((void*)pgv_native, sizeof(*pgv_native));
    if (pgv_native_fd >= 0)
       close(pgv_native_fd);
    pgv_native = NULL;
    pgv_native_fd = -1;
+#endif
 }
 
 static void pgv_native_open(void)
 {
+#ifdef _WIN32
+   wchar_t configured_path[32768];
+   const DWORD path_length = GetEnvironmentVariableW(
+      L"VIRTUALGLOVE_NATIVE_STATE", configured_path,
+      sizeof(configured_path) / sizeof(configured_path[0]));
+   const wchar_t *path = path_length > 0 &&
+      path_length < sizeof(configured_path) / sizeof(configured_path[0])
+      ? configured_path : L"native-state.bin";
+#else
    const char *path = getenv("VIRTUALGLOVE_NATIVE_STATE");
    if (!path || !*path)
