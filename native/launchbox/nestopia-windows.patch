+      pgv_native_mapping, FILE_MAP_READ, 0, 0, sizeof(struct pgv_native_state));
+   if (!pgv_native)
+   {
+      CloseHandle(pgv_native_mapping);
+      CloseHandle(pgv_native_file);
+      pgv_native_mapping = NULL;
+      pgv_native_file = INVALID_HANDLE_VALUE;
+   }
+#else
    pgv_native_fd = open(path, O_RDONLY);
    if (pgv_native_fd < 0)
       return;
