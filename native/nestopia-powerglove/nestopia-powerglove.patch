+/* VirtualGlove latest-sample ABI. This is deliberately local and
+ * read-only: the authenticated receiver owns the record and this core only
+ * accepts complete, current Super Glove Ball samples. */
+#pragma pack(push, 1)
+struct pgv_native_state
+{
+   char magic[4];
+   uint16_t version;
+   uint16_t size;
+   uint32_t guard_begin;
+   uint32_t sequence;
+   uint64_t arrived_ns;
+   int16_t x, y, z, roll;
+   uint8_t flags;
+   uint8_t thumb, index, middle, ring;
+   uint8_t buttons;
+   uint8_t profile;
+   uint8_t reserved[21];
+   uint32_t guard_end;
+};
+#pragma pack(pop)
+
+static int pgv_native_fd = -1;
+static const volatile struct pgv_native_state *pgv_native = NULL;
+
+static uint64_t pgv_monotonic_ns(void)
+{
+   struct timespec value;
+   return clock_gettime(CLOCK_MONOTONIC, &value) == 0
+      ? (uint64_t)value.tv_sec * 1000000000ULL + value.tv_nsec : 0;
+}
+
+static void pgv_native_close(void)
+{
+   if (pgv_native)
+      munmap((void*)pgv_native, sizeof(*pgv_native));
+   if (pgv_native_fd >= 0)
+      close(pgv_native_fd);
+   pgv_native = NULL;
+   pgv_native_fd = -1;
+}
+
+static void pgv_native_open(void)
+{
+   const char *path = getenv("VIRTUALGLOVE_NATIVE_STATE");
+   if (!path || !*path)
+      path = "/run/virtualglove/native-state";
+   pgv_native_close();
+   pgv_native_fd = open(path, O_RDONLY);
+   if (pgv_native_fd < 0)
+      return;
+   void *mapped = mmap(NULL, sizeof(struct pgv_native_state), PROT_READ, MAP_SHARED,
+                       pgv_native_fd, 0);
+   if (mapped == MAP_FAILED)
+   {
+      close(pgv_native_fd);
+      pgv_native_fd = -1;
+      return;
+   }
+   pgv_native = (const volatile struct pgv_native_state*)mapped;
+}
+
+static bool pgv_native_read(struct pgv_native_state *out)
+{
+   if (!pgv_native)
+      pgv_native_open();
+   if (!pgv_native)
+      return false;
+   memcpy(out, (const void*)pgv_native, sizeof(*out));
+   __sync_synchronize();
+   if (memcmp(out->magic, "PGV1", 4) || out->version != 1 ||
+       out->size != sizeof(*out) || (out->guard_begin & 1) ||
+       out->guard_begin != out->guard_end || out->profile != 1 ||
+       (out->flags & 3) != 3)
+      return false;
+   const uint64_t now = pgv_monotonic_ns();
+   return now && out->arrived_ns <= now && now - out->arrived_ns <= 250000000ULL;
+}
