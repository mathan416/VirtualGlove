+static bool NST_CALLBACK powerglove_callback(
+      Api::Base::UserData data, Core::Input::Controllers::PowerGlove& glove)
+{
+   struct pgv_native_state sample;
+   (void)data;
+   const bool valid = pgv_native_read(&sample);
+   glove.x = 128;
+   glove.y = 128;
+   glove.distance = 0;
+   glove.wrist = 0;
+   glove.gesture = Core::Input::Controllers::PowerGlove::GESTURE_OPEN;
+   glove.buttons = 0;
+   if (!valid)
+      return true;
+
+   /* Publish only fields backed by the exact-ROM packet trace and the
+    * documented hardware encoding. Unmapped buttons and wrist stay neutral. */
+   glove.x = (uint8_t)((((int32_t)sample.x + 32767) * 255 + 32767) / 65534);
+   /* Camera Y increases downward. Cabinet validation showed that passing the
+    * host value directly compensates for Nestopia's 128-glove.y packet
+    * transform; the earlier negation inverted physical up and down. */
+   glove.y = (uint8_t)((((int32_t)sample.y + 32767) * 255 + 32767) / 65534);
+   /* The camera axis is positive toward the camera. The hardware packet is
+    * positive away from the screen, so publish the calibrated absolute depth
+    * with the sign reversed instead of Nestopia's keyboard-style accumulator. */
+   glove.distance = (int8_t)(-((int32_t)sample.z * 127 / 32767));
+   if (sample.buttons & (1 << 6))
+      glove.gesture = Core::Input::Controllers::PowerGlove::GESTURE_FIST;
+   else if (sample.buttons & (1 << 7))
+      glove.gesture = Core::Input::Controllers::PowerGlove::GESTURE_FINGER;
+   if (sample.buttons & (1 << 2))
+      glove.buttons |= Core::Input::Controllers::PowerGlove::START;
+   if (sample.buttons & (1 << 3))
+      glove.buttons |= Core::Input::Controllers::PowerGlove::SELECT;
+   return true;
+}
