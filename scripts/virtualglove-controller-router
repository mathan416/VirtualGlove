#!/bin/sh
# Project: VirtualGlove
# File: scripts/virtualglove-controller-router
# Purpose: Launch Controller Router tools from a persistent console installation.
# Author: Iain Bennett
# Copyright (c) 2026 Iain Bennett
# SPDX-License-Identifier: MIT
# Change log:
#   2026-09-19 - Added persistent Recalbox and Batocera Router launcher.
# Full history: docs/CHANGELOG.md and Git history.

set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
export PYTHONPATH="$PROJECT_DIR/src"
exec python3 -m virtualglove.controller_router "$@"
