# Project: VirtualGlove
# File: uno-q/virtualglove-system-shutdown.path
# Purpose: Watch for the fixed VirtualGlove shutdown-request file on the UNO Q host.
# Author: Iain Bennett
# Copyright (c) 2026 Iain Bennett
# SPDX-License-Identifier: MIT
# Change log:
#   2026-09-03 - Added with standardized source documentation.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=Watch for a VirtualGlove system shutdown request

[Path]
PathExists=/home/arduino/ArduinoApps/virtualglove/data/shutdown-request
Unit=virtualglove-system-shutdown.service

[Install]
WantedBy=multi-user.target
