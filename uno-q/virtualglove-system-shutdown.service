# Project: VirtualGlove
# File: uno-q/virtualglove-system-shutdown.service
# Purpose: Consume an authorized shutdown request and initiate a non-blocking UNO Q halt.
# Author: Iain Bennett
# Copyright (c) 2026 Iain Bennett
# SPDX-License-Identifier: MIT
# Change log:
#   2026-09-03 - Added with standardized source documentation.
#   2026-09-03 - Request halt to avoid UNO Q rebooting after poweroff.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=Shut down the UNO Q for VirtualGlove

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f /home/arduino/ArduinoApps/virtualglove/data/shutdown-request
ExecStart=/usr/bin/systemctl --no-block halt
